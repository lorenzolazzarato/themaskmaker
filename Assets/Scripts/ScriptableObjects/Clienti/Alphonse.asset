  m_Script: {fileID: 11500000, guid: 167a01377efe36c498b078461c7127f6, type: 3}
  m_Name: Alphonse
  m_EditorClassIdentifier: Assembly-CSharp::DataCliente
  richiesta: "Hey. You\u2019re the one who makes those magical masks, right? I could
    use your services. Ranulf, that tall fellow guard over there, accused me of fooling
    around with his woman. I didn\u2019t do anything of the sort of course but he
    has challenged me to a duel and I\u2019m troubled; I can\u2019t possibly beat
    that lad, he might be dumb as a rock but have you seen the size of his arms?
    I need something that gives me an edge over him, and I need it fast. I\u2019m
    willing to pay you quite a lot if I can return to you with all my teeth."
  shortRequest: Alphonse needs an edge over his opponent in the upcoming duel.
  rispostaPositiva: "Oh my good lad, you\u2019ve done it! I bested that thug fair
    and square! And here\u2019s your just reward. "
  rispostaNeutra: "Mmm\u2026 I tried your mask mister, I feel the magic in there
    but I\u2019m not sold yet. Do something about it please. "
  rispostaNegativa: "\u2026 Try again."
